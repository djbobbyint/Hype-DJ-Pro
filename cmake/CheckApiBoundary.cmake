# Fails if any UI source includes an engine-internal header.
# Allowed: other UI files ("Foo.h"), the public API ("Api/HypeEngineApi.h"), and system/JUCE headers (<...>).
file(GLOB ui_files "${APP_DIR}/*.h" "${APP_DIR}/*.cpp")
set(violations "")
foreach(f IN LISTS ui_files)
    file(STRINGS "${f}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
    foreach(line IN LISTS includes)
        string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\".*" "\\1" header "${line}")
        if(header MATCHES "/" AND NOT header STREQUAL "Api/HypeEngineApi.h")
            get_filename_component(name "${f}" NAME)
            list(APPEND violations "${name}: #include \"${header}\"")
        endif()
    endforeach()
endforeach()
if(violations)
    list(JOIN violations "\n  " msg)
    message(FATAL_ERROR "UI must only use the public engine API (Source/Api/HypeEngineApi.h):\n  ${msg}")
endif()
message(STATUS "API boundary OK: UI uses only Api/HypeEngineApi.h")
